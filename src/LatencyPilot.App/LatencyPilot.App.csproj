<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyName>LatencyPilot</AssemblyName>
    <RootNamespace>LatencyPilot.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <HotReloadAutoRestart>true</HotReloadAutoRestart>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../LatencyPilot.Core/LatencyPilot.Core.csproj" />
    <ProjectReference Include="../LatencyPilot.Benchmarking/LatencyPilot.Benchmarking.csproj" />
    <ProjectReference Include="../LatencyPilot.Protocol/LatencyPilot.Protocol.csproj" />
    <ProjectReference Include="../LatencyPilot.Platform.Windows/LatencyPilot.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="GenerateLatencyPilotIcon"
          BeforeTargets="PrepareForBuild"
          Inputs="$(MSBuildProjectDirectory)\..\..\eng\Generate-AppIcon.ps1"
          Outputs="$(MSBuildProjectDirectory)\Assets\AppIcon.ico">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\eng\Generate-AppIcon.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\Assets\AppIcon.ico&quot;" />
  </Target>

  <Target Name="WriteLatencyPilotSourceBuildInfo"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\eng\Write-SourceBuildInfo.ps1&quot; -OutputPath &quot;$(TargetDir)BUILD_INFO.txt&quot; -Version &quot;$(Version)&quot;" />
  </Target>

  <Target Name="WriteLatencyPilotPublishedBuildInfo"
          AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(PublishDir)' != ''">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\eng\Write-SourceBuildInfo.ps1&quot; -OutputPath &quot;$(PublishDir)BUILD_INFO.txt&quot; -Version &quot;$(Version)&quot;" />
  </Target>
</Project>
