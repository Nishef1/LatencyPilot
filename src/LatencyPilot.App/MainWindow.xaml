<Window
    x:Class="LatencyPilot.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{StaticResource CanvasBrush}" Padding="32" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="LatencyPilot" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="VersionText"
                           Margin="10,10,0,0"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="v0.0.0" />
            </StackPanel>
            <TextBlock Margin="0,6,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="14"
                       Text="Measure first. Change only what can be verified and reverted." />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="18"
                CornerRadius="12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Phase 2 — read-only observation" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="Hardware inventory stays in the desktop app. Privileged kernel observation is isolated in the Windows service. Tuning remains unavailable." />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="22"
                    CornerRadius="12"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="System inventory" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Margin="0,18,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Operating system" />
                        <TextBlock x:Name="OperatingSystemText" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Margin="0,14,0,4" Foreground="{StaticResource MutedTextBrush}" Text="OS / process architecture" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="OsArchitectureText" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text=" / " Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="ProcessArchitectureText" Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                        <TextBlock Margin="0,14,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Processors available to this process" />
                        <TextBlock x:Name="ProcessAvailableProcessorCountText" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Margin="0,14,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Hardware logical processors" />
                        <TextBlock x:Name="HardwareLogicalProcessorCountText" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Margin="0,14,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Physical cores / SMT cores" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PhysicalCoreCountText" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text=" / " Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="SmtCoreCountText" Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                        <TextBlock Margin="0,14,0,4" Foreground="{StaticResource MutedTextBrush}" Text="CPU packages / processor groups" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PackageCountText" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text=" / " Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="ProcessorGroupCountText" Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="TopologyStatusText"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,18,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Present Plug and Play devices" />
                        <TextBlock x:Name="PresentDeviceCountText" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="DeviceInventoryStatusText"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2"
                    Padding="22"
                    CornerRadius="12"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Kernel latency observation" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="This is a single DPC/ISR observation window, not yet a quality-gated baseline. Privileged capture runs only through the local service." />

                        <TextBlock Margin="0,18,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Observation service" />
                        <TextBlock x:Name="ServiceStatusText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Text="Checking service…" />

                        <Button x:Name="CaptureObservationButton"
                                Margin="0,18,0,0"
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                Click="CaptureObservationButton_Click"
                                Content="Capture 5 s observation" />

                        <TextBlock x:Name="KernelCaptureStatusText"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="No kernel observation has been run yet." />

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="DPC events" />
                                <TextBlock x:Name="DpcCountText" Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="—" />
                                <TextBlock Margin="0,14,0,0" Foreground="{StaticResource MutedTextBrush}" Text="DPC p99 / p99.9" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock x:Name="DpcP99Text" Foreground="{StaticResource TextBrush}" Text="—" />
                                    <TextBlock Text=" / " Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="DpcP999Text" Foreground="{StaticResource TextBrush}" Text="—" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="ISR events" />
                                <TextBlock x:Name="IsrCountText" Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="—" />
                                <TextBlock Margin="0,14,0,0" Foreground="{StaticResource MutedTextBrush}" Text="ISR p99 / p99.9" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock x:Name="IsrP99Text" Foreground="{StaticResource TextBrush}" Text="—" />
                                    <TextBlock Text=" / " Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="IsrP999Text" Foreground="{StaticResource TextBrush}" Text="—" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,18,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Processors observed" />
                        <TextBlock x:Name="ObservedProcessorCountText" Foreground="{StaticResource TextBrush}" Text="—" />

                        <TextBlock Margin="0,18,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Module attribution coverage" />
                        <TextBlock x:Name="ModuleAttributionCoverageText" Foreground="{StaticResource TextBrush}" Text="—" TextWrapping="Wrap" />

                        <TextBlock Margin="0,14,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Top resolved module" />
                        <TextBlock x:Name="TopModuleText" Foreground="{StaticResource TextBrush}" Text="—" TextWrapping="Wrap" />

                        <TextBlock Margin="0,22,0,0" Text="Safety boundary" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="The service exposes only typed read-only observation commands. Registry, MSI, affinity, power and network mutation remain unavailable." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
