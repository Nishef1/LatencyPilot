<Window
    x:Class="LatencyPilot.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="White" Loaded="RootGrid_Loaded">
        <ScrollViewer>
            <StackPanel Padding="24" Spacing="10">
                <TextBlock Text="LatencyPilot" FontSize="28" FontWeight="SemiBold" Foreground="Black" />
                <TextBlock x:Name="VersionText" Text="v0.0.1" Foreground="DimGray" />
                <TextBlock Text="WinUI startup probe · read-only observation build" Foreground="DimGray" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border x:Name="ServiceStatusDot" Width="8" Height="8" Background="Goldenrod" />
                    <TextBlock x:Name="ServiceStatusBadgeText" Text="Checking service" Foreground="Black" />
                </StackPanel>
                <TextBlock x:Name="ServiceStatusText" Text="Checking service…" Foreground="Black" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RefreshServiceButton" Content="Refresh service" Click="RefreshServiceButton_Click" />
                    <Button x:Name="CaptureObservationButton" Content="Capture 5 seconds" IsEnabled="False" Click="CaptureObservationButton_Click" />
                </StackPanel>

                <TextBlock Text="System inventory" FontSize="18" FontWeight="SemiBold" Foreground="Black" />
                <TextBlock x:Name="OperatingSystemText" Text="Loading…" Foreground="Black" TextWrapping="Wrap" />
                <TextBlock x:Name="OsArchitectureText" Text="—" Foreground="Black" />
                <TextBlock x:Name="ProcessArchitectureText" Text="—" Foreground="Black" />
                <TextBlock x:Name="ProcessAvailableProcessorCountText" Text="—" Foreground="Black" />
                <TextBlock x:Name="HardwareLogicalProcessorCountText" Text="—" Foreground="Black" />
                <TextBlock x:Name="PhysicalCoreCountText" Text="—" Foreground="Black" />
                <TextBlock x:Name="SmtCoreCountText" Text="—" Foreground="Black" />
                <TextBlock x:Name="PackageCountText" Text="—" Foreground="Black" />
                <TextBlock x:Name="ProcessorGroupCountText" Text="—" Foreground="Black" />
                <TextBlock x:Name="PresentDeviceCountText" Text="—" Foreground="Black" />
                <TextBlock x:Name="TopologyStatusText" Foreground="DimGray" TextWrapping="Wrap" />
                <TextBlock x:Name="DeviceInventoryStatusText" Foreground="DimGray" TextWrapping="Wrap" />

                <TextBlock Text="Kernel latency observation" FontSize="18" FontWeight="SemiBold" Foreground="Black" />
                <TextBlock x:Name="KernelCaptureStatusText" Text="No observation has been captured yet." Foreground="Black" TextWrapping="Wrap" />
                <TextBlock x:Name="DpcCountText" Text="—" Foreground="Black" />
                <TextBlock x:Name="DpcP99Text" Text="—" Foreground="Black" />
                <TextBlock x:Name="DpcP999Text" Text="—" Foreground="Black" />
                <TextBlock x:Name="IsrCountText" Text="—" Foreground="Black" />
                <TextBlock x:Name="IsrP99Text" Text="—" Foreground="Black" />
                <TextBlock x:Name="IsrP999Text" Text="—" Foreground="Black" />
                <TextBlock x:Name="ObservedProcessorCountText" Text="—" Foreground="Black" />
                <ProgressBar x:Name="ModuleCoverageBar" Minimum="0" Maximum="100" Value="0" />
                <TextBlock x:Name="ModuleAttributionCoverageText" Text="—" Foreground="DimGray" TextWrapping="Wrap" />
                <TextBlock x:Name="TopModuleText" Text="No observation yet." Foreground="DimGray" TextWrapping="Wrap" />
                <ListView x:Name="TopModulesList" MaxHeight="160" SelectionMode="None" />
                <ListView x:Name="TopProcessorsList" MaxHeight="160" SelectionMode="None" />
                <TextBlock x:Name="ObservationQualityText" Text="Quality evidence will appear after capture." Foreground="DimGray" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
