<Window
    x:Class="LatencyPilot.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LatencyPilot.App.Controls">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          Background="Transparent"
          RequestedTheme="Light"
          Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBarDragRegion"
              Height="{StaticResource TitleBarHeight}"
              Background="Transparent">
            <Grid Margin="16,0,148,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="10">
                    <Border Width="38"
                            Height="38"
                            CornerRadius="11"
                            Background="{ThemeResource AccentSoftBrush}">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Glyph="&#xE9D2;"
                                  FontSize="20"
                                  Foreground="{ThemeResource AccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="LatencyPilot"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextBrush}" />
                        <TextBlock x:Name="VersionText"
                                   Text="v—"
                                   FontSize="11"
                                   Foreground="{ThemeResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Style="{StaticResource PillBorderStyle}"
                        Background="{ThemeResource SuccessSoftBrush}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Border Width="7"
                                Height="7"
                                CornerRadius="4"
                                Background="{ThemeResource SuccessBrush}" />
                        <TextBlock Text="Observation only"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource SuccessBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <NavigationView x:Name="AppNavigationView"
                        Grid.Row="1"
                        Background="Transparent"
                        PaneDisplayMode="Auto"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True"
                        OpenPaneLength="208"
                        CompactPaneLength="48"
                        SelectionChanged="AppNavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OverviewNavItem"
                                    Content="Overview"
                                    Tag="overview"
                                    IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE80F;" FontSize="17" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="MeasureNavItem"
                                    Content="Measure"
                                    Tag="measure">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE768;" FontSize="17" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DevicesNavItem"
                                    Content="Devices"
                                    Tag="devices">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE950;" FontSize="17" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="EvidenceNavItem"
                                    Content="Evidence"
                                    Tag="evidence">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8A5;" FontSize="17" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Button x:Name="AppearanceButton"
                        Style="{StaticResource QuietButtonStyle}"
                        Width="38"
                        Height="38"
                        Padding="0"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Appearance"
                        ToolTipService.ToolTip="Appearance">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE708;"
                              FontSize="17" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem Text="Light" Tag="Light" GroupName="Appearance" Click="Appearance_Click" IsChecked="True" />
                            <RadioMenuFlyoutItem Text="Dark" Tag="Dark" GroupName="Appearance" Click="Appearance_Click" />
                            <RadioMenuFlyoutItem Text="Use Windows setting" Tag="Default" GroupName="Appearance" Click="Appearance_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="ServiceStatusCard"
                        Margin="{StaticResource WorkspaceMargin}"
                        Padding="12,8"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{ThemeResource PremiumSurfaceBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ServiceStatusDot"
                                Width="8"
                                Height="8"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentBrush}" />
                        <TextBlock x:Name="ServiceStatusBadgeText"
                                   Grid.Column="1"
                                   Text="Checking service"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextBrush}" />
                        <TextBlock x:Name="ServiceStatusText"
                                   Grid.Column="2"
                                   Text="Checking the local observation service…"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource MutedTextBrush}" />
                        <Button x:Name="RefreshServiceButton"
                                Grid.Column="3"
                                Click="RefreshServiceButton_Click"
                                Style="{StaticResource QuietButtonStyle}"
                                Padding="10,5"
                                MinHeight="30"
                                ToolTipService.ToolTip="Refresh service status (Ctrl+R)"
                                AutomationProperties.Name="Refresh service status"
                                AutomationProperties.AcceleratorKey="Ctrl+R">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="R" />
                            </Button.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" x:Name="PageHost">
                    <!-- OVERVIEW -->
                    <ScrollViewer x:Name="OverviewView"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="OverviewContent"
                              MaxWidth="{StaticResource ContentMaxWidth}"
                              Padding="{StaticResource PagePadding}"
                              HorizontalAlignment="Stretch">
                            <StackPanel Spacing="{StaticResource DashboardGap}">
                                <Grid x:Name="OverviewAnchor" ColumnSpacing="16" RowSpacing="12" MinHeight="68">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="HeaderActionsColumn" Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Style="{StaticResource IconTileStyle}">
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                      Glyph="&#xE9D2;"
                                                      FontSize="22"
                                                      Foreground="{ThemeResource AccentBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Latency health" Style="{StaticResource HeroTitleTextStyle}" />
                                            <TextBlock Text="See what is happening now, whether the baseline is trustworthy, and what to do next."
                                                       Style="{StaticResource MutedBodyTextStyle}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="HeaderActions"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Spacing="8">
                                        <Button x:Name="CaptureObservationButton"
                                                IsEnabled="False"
                                                Click="CaptureObservationButton_Click"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                AutomationProperties.Name="Quick snapshot · 5 s"
                                                ToolTipService.ToolTip="Capture a five-second diagnostic snapshot (Ctrl+O)"
                                                AutomationProperties.AcceleratorKey="Ctrl+O">
                                            <Button.KeyboardAccelerators>
                                                <KeyboardAccelerator Modifiers="Control" Key="O" />
                                            </Button.KeyboardAccelerators>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE768;" FontSize="14" />
                                                <TextBlock Text="Quick snapshot · 5 s" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="CaptureBaselineButton"
                                                IsEnabled="False"
                                                Click="CaptureBaselineButton_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                AutomationProperties.Name="Build baseline · ~2 min"
                                                ToolTipService.ToolTip="Build five repeated 20-second windows after preparation is confirmed (Ctrl+B)"
                                                AutomationProperties.AcceleratorKey="Ctrl+B">
                                            <Button.KeyboardAccelerators>
                                                <KeyboardAccelerator Modifiers="Control" Key="B" />
                                            </Button.KeyboardAccelerators>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE81E;" FontSize="14" />
                                                <TextBlock Text="Build baseline · ~2 min" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ExportEvidenceButton"
                                                IsEnabled="False"
                                                Click="ExportEvidenceButton_Click"
                                                Style="{StaticResource QuietButtonStyle}"
                                                AutomationProperties.Name="Export JSON"
                                                ToolTipService.ToolTip="Export the latest completed aggregate evidence as JSON (Ctrl+E)"
                                                AutomationProperties.AcceleratorKey="Ctrl+E">
                                            <Button.KeyboardAccelerators>
                                                <KeyboardAccelerator Modifiers="Control" Key="E" />
                                            </Button.KeyboardAccelerators>
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE898;" FontSize="14" />
                                                <TextBlock Text="Export" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="SummaryGrid" ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource DashboardMetricStyle}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="DPC p99" Style="{StaticResource MetricLabelTextStyle}" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource MetricIconStyle}" Background="{ThemeResource ChartPrimarySoftBrush}">
                                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9D2;" FontSize="21" Foreground="{ThemeResource ChartAccentPrimaryBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="DpcP99SummaryText" Text="—" Style="{StaticResource MetricValueTextStyle}" />
                                                    <TextBlock x:Name="DpcP99SummaryDetailText" Text="Awaiting evidence" Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource DashboardMetricStyle}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="ISR p99" Style="{StaticResource MetricLabelTextStyle}" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource MetricIconStyle}" Background="{ThemeResource AccentSoftBrush}">
                                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA86;" FontSize="21" Foreground="{ThemeResource ChartAccentSecondaryBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="IsrP99SummaryText" Text="—" Style="{StaticResource MetricValueTextStyle}" />
                                                    <TextBlock x:Name="IsrP99SummaryDetailText" Text="Awaiting evidence" Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource DashboardMetricStyle}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="CPU concentration" Style="{StaticResource MetricLabelTextStyle}" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource MetricIconStyle}" Background="{ThemeResource ChartWarmSoftBrush}">
                                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9D9;" FontSize="21" Foreground="{ThemeResource ChartWarmBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="CpuConcentrationSummaryText" Text="—" Style="{StaticResource MetricValueTextStyle}" />
                                                    <TextBlock x:Name="CpuConcentrationSummaryDetailText" Text="Awaiting evidence" Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Style="{StaticResource DashboardMetricStyle}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Baseline &amp; readiness" Style="{StaticResource MetricLabelTextStyle}" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource MetricIconStyle}" Background="{ThemeResource SurfaceAltBrush}">
                                                    <FontIcon x:Name="BaselineSummaryIcon"
                                                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                              Glyph="&#xE823;"
                                                              FontSize="21"
                                                              Foreground="{ThemeResource MutedTextBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="BaselineSummaryText"
                                                               Text="Not captured"
                                                               FontSize="17"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock x:Name="BaselineSummaryDetailText" Text="Awaiting evidence" Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid x:Name="MeasureAnchor" ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ChartCardStyle}">
                                        <StackPanel Spacing="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Latency profile" Style="{StaticResource SubsectionTitleTextStyle}" />
                                                    <TextBlock x:Name="LatencyChartSubtitleText" Text="Latest DPC / ISR percentile shape" Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Border Width="7" Height="7" CornerRadius="4" Background="{ThemeResource ChartAccentPrimaryBrush}" />
                                                        <TextBlock Text="DPC" Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Border Width="7" Height="7" CornerRadius="4" Background="{ThemeResource ChartAccentSecondaryBrush}" />
                                                        <TextBlock Text="ISR" Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            <controls:LatencyProfileChart x:Name="LatencyProfileChart" Height="{StaticResource ChartPlotHeight}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ChartCardStyle}">
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="CPU interrupt distribution" Style="{StaticResource SubsectionTitleTextStyle}" />
                                                <TextBlock Text="Share of observed DPC + ISR events" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <controls:CpuDistributionChart x:Name="CpuDistributionChart" Height="{StaticResource ChartPlotHeight}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartCardStyle}">
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Top modules by kernel time" Style="{StaticResource SubsectionTitleTextStyle}" />
                                                <TextBlock Text="Inclusive observed DPC / ISR duration" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <controls:ModuleContributionChart x:Name="ModuleContributionChart" Height="{StaticResource ChartCompactPlotHeight}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ChartCardStyle}">
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="CPU interrupt map" Style="{StaticResource SubsectionTitleTextStyle}" />
                                                <TextBlock Text="DPC and ISR share by busiest processors" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <controls:CpuInterruptMap x:Name="CpuInterruptMap" Height="{StaticResource ChartCompactPlotHeight}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource DashboardCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="68" Height="68" CornerRadius="18" Background="{ThemeResource AccentSoftBrush}">
                                            <Grid>
                                                <Image x:Name="SystemArtwork" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                                                <FontIcon x:Name="SystemArtworkFallback"
                                                          FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                          Glyph="&#xE7F8;"
                                                          FontSize="28"
                                                          Foreground="{ThemeResource AccentBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock x:Name="OperatingSystemText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource TextBrush}" />
                                            <TextBlock x:Name="PrimaryGpuText" Text="Detecting display adapter…" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource TextBrush}" />
                                            <TextBlock x:Name="PrimaryGpuDriverText" Text="" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Logical" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock x:Name="HardwareLogicalProcessorCountText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                            </StackPanel>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Cores" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock x:Name="PhysicalCoreCountText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                            </StackPanel>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="SMT" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock x:Name="SmtCoreCountText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- MEASURE -->
                    <ScrollViewer x:Name="MeasureView"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="MeasureContent"
                              MaxWidth="{StaticResource ContentMaxWidth}"
                              Padding="{StaticResource PagePadding}"
                              HorizontalAlignment="Stretch">
                            <StackPanel Spacing="{StaticResource DashboardGap}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Measure" Style="{StaticResource HeroTitleTextStyle}" />
                                        <TextBlock Text="Capture a quick diagnostic snapshot or build a repeatable five-window baseline."
                                                   Style="{StaticResource MutedBodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Click="CaptureObservationButton_Click"
                                                IsEnabled="{Binding IsEnabled, ElementName=CaptureObservationButton}"
                                                Style="{StaticResource SecondaryButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE768;" FontSize="14" />
                                                <TextBlock Text="Quick snapshot" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="CaptureBaselineButton_Click"
                                                IsEnabled="{Binding IsEnabled, ElementName=CaptureBaselineButton}"
                                                Style="{StaticResource PrimaryButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE81E;" FontSize="14" />
                                                <TextBlock Text="Build baseline" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="BaselineAnchor" ColumnSpacing="12" RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Baseline preparation" Style="{StaticResource SubsectionTitleTextStyle}" />
                                                    <TextBlock Text="Keep the workload steady across five repeated windows." Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                                <ComboBox x:Name="DashboardScenarioComboBox"
                                                          Grid.Column="1"
                                                          MinWidth="184"
                                                          VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid x:Name="BaselinePreparationHost" />
                                            <ProgressBar x:Name="BaselineProgressBar"
                                                         Minimum="0"
                                                         Maximum="5"
                                                         Value="0"
                                                         Height="5"
                                                         AutomationProperties.Name="Baseline capture progress" />
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="BaselineStatusText"
                                                           Text="Confirm preparation to unlock the repeated baseline."
                                                           FontSize="11"
                                                           MaxLines="3"
                                                           TextWrapping="Wrap"
                                                           Foreground="{ThemeResource MutedTextBrush}" />
                                                <Border Grid.Column="1"
                                                        Style="{StaticResource PillBorderStyle}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="BaselineVerdictText"
                                                               Text="Not captured"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextBrush}" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE768;" FontSize="17" Foreground="{ThemeResource AccentBrush}" />
                                                <TextBlock Text="Recent snapshot" Style="{StaticResource SubsectionTitleTextStyle}" />
                                            </StackPanel>
                                            <TextBlock x:Name="RecentSnapshotStatusText"
                                                       Text="No snapshot captured yet"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextBrush}" />
                                            <TextBlock x:Name="RecentSnapshotSummaryText"
                                                       Text="Take a quick snapshot to reveal the current tail, CPU concentration, and dominant modules."
                                                       MaxLines="5"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                            <Button Click="CaptureObservationButton_Click"
                                                    IsEnabled="{Binding IsEnabled, ElementName=CaptureObservationButton}"
                                                    Style="{StaticResource QuietButtonStyle}"
                                                    HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE768;" FontSize="14" />
                                                    <TextBlock Text="Take snapshot" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- DEVICES -->
                    <ScrollViewer x:Name="DevicesView"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid MaxWidth="{StaticResource ContentMaxWidth}"
                              Padding="{StaticResource PagePadding}"
                              HorizontalAlignment="Stretch">
                            <StackPanel Spacing="{StaticResource DashboardGap}">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Devices" Style="{StaticResource HeroTitleTextStyle}" />
                                    <TextBlock Text="Read-only evidence for the hardware paths that can affect latency."
                                               Style="{StaticResource MutedBodyTextStyle}" />
                                </StackPanel>

                                <Grid ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7F4;" FontSize="19" Foreground="{ThemeResource AccentBrush}" />
                                                <TextBlock Text="Graphics" Style="{StaticResource SubsectionTitleTextStyle}" />
                                            </StackPanel>
                                            <TextBlock x:Name="DisplayEvidenceText" Text="—" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                            <TextBlock Text="Adapter identity, driver and interrupt evidence." Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE968;" FontSize="19" Foreground="{ThemeResource AccentBrush}" />
                                                <TextBlock Text="Network" Style="{StaticResource SubsectionTitleTextStyle}" />
                                            </StackPanel>
                                            <TextBlock x:Name="NetworkEvidenceText" Text="—" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                            <TextBlock Text="Adapter, RSS and route evidence." Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE88E;" FontSize="19" Foreground="{ThemeResource AccentBrush}" />
                                                <TextBlock Text="USB / xHCI" Style="{StaticResource SubsectionTitleTextStyle}" />
                                            </StackPanel>
                                            <TextBlock x:Name="UsbEvidenceText" Text="—" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                            <TextBlock Text="Controller, port route and interrupt evidence." Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource DashboardCardStyle}">
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="System inventory" Style="{StaticResource SubsectionTitleTextStyle}" />
                                            <Grid ColumnSpacing="24" RowSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Present devices" Style="{StaticResource CaptionTextStyle}" />
                                                    <TextBlock x:Name="PresentDeviceCountText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="Packages / groups" Style="{StaticResource CaptionTextStyle}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock x:Name="PackageCountText" Text="—" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                                        <TextBlock Text="/" Foreground="{ThemeResource SubtleTextBrush}" />
                                                        <TextBlock x:Name="ProcessorGroupCountText" Text="—" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <TextBlock Text="OS / process" Style="{StaticResource CaptionTextStyle}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock x:Name="OsArchitectureText" Text="—" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                                        <TextBlock Text="/" Foreground="{ThemeResource SubtleTextBrush}" />
                                                        <TextBlock x:Name="ProcessArchitectureText" Text="—" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Visibility="Collapsed">
                                                <TextBlock x:Name="ProcessAvailableProcessorCountText" />
                                                <TextBlock x:Name="TopologyStatusText" />
                                                <TextBlock x:Name="DeviceInventoryStatusText" />
                                            </StackPanel>
                                            <TextBlock x:Name="DeviceEvidenceStatusText"
                                                       Text="Inspect driver and interrupt details."
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <Button x:Name="InspectDeviceEvidenceButton"
                                                Grid.Column="1"
                                                Content="View details"
                                                Click="InspectDeviceEvidenceButton_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                VerticalAlignment="Bottom"
                                                AutomationProperties.Name="Inspect read-only device evidence" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- EVIDENCE -->
                    <ScrollViewer x:Name="EvidenceView"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid MaxWidth="{StaticResource ContentMaxWidth}"
                              Padding="{StaticResource PagePadding}"
                              HorizontalAlignment="Stretch">
                            <StackPanel Spacing="{StaticResource DashboardGap}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Evidence" Style="{StaticResource HeroTitleTextStyle}" />
                                        <TextBlock Text="Exact counts, attribution, baseline windows and export provenance."
                                                   Style="{StaticResource MutedBodyTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Click="ExportEvidenceButton_Click"
                                            IsEnabled="{Binding IsEnabled, ElementName=ExportEvidenceButton}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE898;" FontSize="14" />
                                            <TextBlock Text="Export JSON" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid x:Name="EvidenceDetails">
                                    <Border x:Name="ObservationCard" Style="{StaticResource DashboardCardStyle}">
                                        <StackPanel Spacing="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Exact evidence" Style="{StaticResource SubsectionTitleTextStyle}" />
                                                    <TextBlock Text="Raw counts, attribution coverage, baseline windows and capture-quality context." Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                                <TextBlock x:Name="KernelCaptureStatusText"
                                                           Grid.Column="1"
                                                           MaxWidth="420"
                                                           Text="No observation has been captured yet."
                                                           TextAlignment="Right"
                                                           Style="{StaticResource CaptionTextStyle}" />
                                            </Grid>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource MetricTileStyle}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="DPC events" Style="{StaticResource MetricLabelTextStyle}" />
                                                        <TextBlock x:Name="DpcCountText" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                                        <TextBlock x:Name="DpcP99Text" Text="—" Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Style="{StaticResource MetricTileStyle}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="DPC p99.9" Style="{StaticResource MetricLabelTextStyle}" />
                                                        <TextBlock x:Name="DpcP999Text" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource MetricTileStyle}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="ISR events" Style="{StaticResource MetricLabelTextStyle}" />
                                                        <TextBlock x:Name="IsrCountText" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                                        <TextBlock x:Name="IsrP99Text" Text="—" Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="3" Style="{StaticResource MetricTileStyle}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="ISR p99.9" Style="{StaticResource MetricLabelTextStyle}" />
                                                        <TextBlock x:Name="IsrP999Text" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="Driver attribution" Style="{StaticResource MetricLabelTextStyle}" />
                                                    <ProgressBar x:Name="ModuleCoverageBar" Minimum="0" Maximum="100" Value="0" Height="5" />
                                                    <TextBlock x:Name="ModuleAttributionCoverageText" Text="—" Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" MinWidth="100" Spacing="2">
                                                    <TextBlock Text="CPUs observed" Style="{StaticResource MetricLabelTextStyle}" />
                                                    <TextBlock x:Name="ObservedProcessorCountText" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="Top modules" Style="{StaticResource MetricLabelTextStyle}" />
                                                    <TextBlock x:Name="TopModuleText" Text="No observation yet." Style="{StaticResource CaptionTextStyle}" />
                                                    <ListView x:Name="TopModulesList" Style="{StaticResource EvidenceListStyle}" SelectionMode="None">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Padding="0,5" ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Spacing="1">
                                                                        <TextBlock Text="{Binding Name}" Foreground="{ThemeResource TextBrush}" />
                                                                        <TextBlock Text="{Binding EventSummary}" Style="{StaticResource CaptionTextStyle}" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding DurationSummary}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="6">
                                                    <TextBlock Text="CPU concentration" Style="{StaticResource MetricLabelTextStyle}" />
                                                    <ListView x:Name="TopProcessorsList" Style="{StaticResource EvidenceListStyle}" SelectionMode="None">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Padding="0,5" ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Spacing="1">
                                                                        <TextBlock Text="{Binding Name}" Foreground="{ThemeResource TextBrush}" />
                                                                        <TextBlock Text="{Binding EventSummary}" Style="{StaticResource CaptionTextStyle}" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding TailSummary}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock x:Name="ObservationQualityText" Text="Quality evidence will appear after capture." Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock x:Name="EvidenceExportStatusText" Text="Complete an observation or repeated baseline to enable JSON evidence export." Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock x:Name="BaselineMetricsText" Text="No baseline metrics yet." Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock x:Name="BaselineReasonsText" Text="Duration, capture integrity, sample adequacy, noise and drift reasons will appear here." Style="{StaticResource CaptionTextStyle}" />
                                            <ListView x:Name="BaselineWindowsList" Style="{StaticResource EvidenceListStyle}" SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Padding="0,5" ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding IntegritySummary}" Style="{StaticResource CaptionTextStyle}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding DpcSummary}" Style="{StaticResource CaptionTextStyle}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding IsrSummary}" Style="{StaticResource CaptionTextStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>