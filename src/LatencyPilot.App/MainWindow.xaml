<Window x:Class="LatencyPilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LatencyPilot"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="LatencyPilot" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="14"
                       Text="Measure first. Change only what can be verified and reverted." />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="18"
                CornerRadius="12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Phase 1 — observation-only foundation" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="System tuning is intentionally unavailable in this build. No registry, interrupt-affinity, MSI, power or network settings are changed." />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="22"
                    CornerRadius="12"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="System snapshot" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Margin="0,18,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Operating system" />
                    <TextBlock x:Name="OperatingSystemText" TextWrapping="Wrap" />
                    <TextBlock Margin="0,16,0,4" Foreground="{StaticResource MutedTextBrush}" Text="OS architecture" />
                    <TextBlock x:Name="OsArchitectureText" />
                    <TextBlock Margin="0,16,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Process architecture" />
                    <TextBlock x:Name="ProcessArchitectureText" />
                    <TextBlock Margin="0,16,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Logical processors visible to LatencyPilot" />
                    <TextBlock x:Name="LogicalProcessorCountText" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="22"
                    CornerRadius="12"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="What comes next" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Margin="0,18,0,0" Text="Read-only ETW baseline" FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="DPC/ISR capture, per-CPU distribution and driver attribution." />
                    <TextBlock Margin="0,18,0,0" Text="Baseline quality" FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="Repeated windows, noise-floor estimation and drift detection before any optimization is unlocked." />
                    <TextBlock Margin="0,18,0,0" Text="Safe experiments" FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="Only after snapshot, journal, verify and rollback infrastructure exists." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
