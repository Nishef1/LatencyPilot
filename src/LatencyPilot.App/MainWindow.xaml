<Window
    x:Class="LatencyPilot.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource CanvasBrush}"
          Loaded="RootGrid_Loaded">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="1480"
                  Margin="0"
                  Padding="28,24,28,40"
                  HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="LatencyPilot"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextBrush}" />
                            <Border Padding="8,3"
                                    Margin="0,7,0,0"
                                    VerticalAlignment="Top"
                                    CornerRadius="10"
                                    Background="{ThemeResource SurfaceAltBrush}">
                                <TextBlock x:Name="VersionText"
                                           FontSize="12"
                                           Foreground="{ThemeResource MutedTextBrush}"
                                           Text="v—" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Evidence-driven Windows latency analysis"
                                   FontSize="14"
                                   Foreground="{ThemeResource MutedTextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <Border Padding="12,7"
                                CornerRadius="14"
                                Background="{ThemeResource SurfaceBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Border x:Name="ServiceStatusDot"
                                        Width="8"
                                        Height="8"
                                        Margin="0,1,0,0"
                                        CornerRadius="4"
                                        Background="{ThemeResource WarningBrush}" />
                                <TextBlock x:Name="ServiceStatusBadgeText"
                                           Text="Checking service"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Padding="12,7"
                                CornerRadius="14"
                                Background="{ThemeResource SurfaceBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="Read-only"
                                       FontSize="12"
                                       Foreground="{ThemeResource SuccessBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Padding="18,16"
                        CornerRadius="16"
                        Background="{ThemeResource SurfaceBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="10"
                                Height="10"
                                Margin="0,4,0,0"
                                CornerRadius="5"
                                Background="{ThemeResource AccentBrush}"
                                VerticalAlignment="Top" />

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Phase 2 · observation + baseline quality"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextBrush}" />
                            <TextBlock Text="Capture DPC/ISR activity, identify CPU/module concentration, then build repeated quality-checked baseline evidence without changing system configuration."
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                x:Name="RefreshServiceButton"
                                VerticalAlignment="Center"
                                Click="RefreshServiceButton_Click"
                                Content="Refresh service"
                                ToolTipService.ToolTip="Refresh service status (Ctrl+R)"
                                AutomationProperties.AcceleratorKey="Ctrl+R">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="R" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="4" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1.6*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="18">
                        <Border Padding="20"
                                CornerRadius="16"
                                Background="{ThemeResource SurfaceBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="System"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextBrush}" />
                                    <TextBlock Text="Read-only inventory from Windows APIs"
                                               FontSize="12"
                                               Foreground="{ThemeResource MutedTextBrush}" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Operating system"
                                               FontSize="12"
                                               Foreground="{ThemeResource MutedTextBrush}" />
                                    <TextBlock x:Name="OperatingSystemText"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextBrush}" />
                                </StackPanel>

                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0"
                                            Padding="14"
                                            CornerRadius="12"
                                            Background="{ThemeResource SurfaceAltBrush}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Logical CPUs" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                            <TextBlock x:Name="HardwareLogicalProcessorCountText" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" Text="—" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Padding="14"
                                            CornerRadius="12"
                                            Background="{ThemeResource SurfaceAltBrush}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Physical cores" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                            <TextBlock x:Name="PhysicalCoreCountText" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" Text="—" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0"
                                            Padding="14"
                                            CornerRadius="12"
                                            Background="{ThemeResource SurfaceAltBrush}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="SMT cores" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                            <TextBlock x:Name="SmtCoreCountText" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" Text="—" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1"
                                            Padding="14"
                                            CornerRadius="12"
                                            Background="{ThemeResource SurfaceAltBrush}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="PnP devices" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                            <TextBlock x:Name="PresentDeviceCountText" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" Text="—" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="CPU packages / groups" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock x:Name="PackageCountText" Foreground="{ThemeResource TextBrush}" />
                                            <TextBlock Text="/" Foreground="{ThemeResource MutedTextBrush}" />
                                            <TextBlock x:Name="ProcessorGroupCountText" Foreground="{ThemeResource TextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="OS / process" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock x:Name="OsArchitectureText" Foreground="{ThemeResource TextBrush}" />
                                            <TextBlock Text="/" Foreground="{ThemeResource MutedTextBrush}" />
                                            <TextBlock x:Name="ProcessArchitectureText" Foreground="{ThemeResource TextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Processors available to app" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                    <TextBlock x:Name="ProcessAvailableProcessorCountText" Foreground="{ThemeResource TextBrush}" />
                                </StackPanel>

                                <TextBlock x:Name="TopologyStatusText"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource MutedTextBrush}" />
                                <TextBlock x:Name="DeviceInventoryStatusText"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Padding="20"
                                CornerRadius="16"
                                Background="{ThemeResource SurfaceBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Safety boundary"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextBrush}" />
                                <TextBlock Text="The service exposes typed read-only observation commands only. MSI, affinity, power, network and device-policy mutation are disabled in this pre-alpha build."
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource MutedTextBrush}" />
                                <TextBlock Text="Evidence levels stay separate: stored interrupt configuration ≠ allocated IRQ/resource assignment ≠ runtime DPC/ISR behavior."
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource MutedTextBrush}" />
                                <TextBlock Text="Only a repeated baseline that passes capture-integrity, sample, noise and drift checks can qualify for later comparison."
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource WarningBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="22"
                            CornerRadius="16"
                            Background="{ThemeResource SurfaceBrush}"
                            BorderBrush="{ThemeResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Kernel latency observation"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextBrush}" />
                                    <TextBlock Text="Inspect one five-second window, or collect five repeated windows for the Stage C baseline quality gate."
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource MutedTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                    <Button x:Name="CaptureObservationButton"
                                            IsEnabled="False"
                                            Click="CaptureObservationButton_Click"
                                            Content="Capture 5 seconds"
                                            ToolTipService.ToolTip="Capture a five-second observation (Ctrl+O)"
                                            AutomationProperties.AcceleratorKey="Ctrl+O">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Modifiers="Control" Key="O" />
                                        </Button.KeyboardAccelerators>
                                    </Button>
                                    <Button x:Name="CaptureBaselineButton"
                                            IsEnabled="False"
                                            Click="CaptureBaselineButton_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Content="Build baseline"
                                            ToolTipService.ToolTip="Build a five-window baseline (Ctrl+B)"
                                            AutomationProperties.AcceleratorKey="Ctrl+B">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Modifiers="Control" Key="B" />
                                        </Button.KeyboardAccelerators>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Padding="14" CornerRadius="12" Background="{ThemeResource SurfaceAltBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="ServiceStatusText" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" Text="Checking service…" />
                                    <TextBlock x:Name="KernelCaptureStatusText" Foreground="{ThemeResource TextBrush}" TextWrapping="Wrap" Text="No observation has been captured yet." />
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="14" CornerRadius="12" Background="{ThemeResource SurfaceAltBrush}"><StackPanel Spacing="4"><TextBlock Text="DPC events" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" /><TextBlock x:Name="DpcCountText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" /><TextBlock x:Name="DpcP99Text" Text="—" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" /></StackPanel></Border>
                                <Border Grid.Column="1" Padding="14" CornerRadius="12" Background="{ThemeResource SurfaceAltBrush}"><StackPanel Spacing="4"><TextBlock Text="DPC p99.9" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" /><TextBlock x:Name="DpcP999Text" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" /><TextBlock Text="tail latency" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" /></StackPanel></Border>
                                <Border Grid.Column="2" Padding="14" CornerRadius="12" Background="{ThemeResource SurfaceAltBrush}"><StackPanel Spacing="4"><TextBlock Text="ISR events" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" /><TextBlock x:Name="IsrCountText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" /><TextBlock x:Name="IsrP99Text" Text="—" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" /></StackPanel></Border>
                                <Border Grid.Column="3" Padding="14" CornerRadius="12" Background="{ThemeResource SurfaceAltBrush}"><StackPanel Spacing="4"><TextBlock Text="ISR p99.9" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" /><TextBlock x:Name="IsrP999Text" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" /><TextBlock Text="tail latency" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" /></StackPanel></Border>
                            </Grid>

                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6"><TextBlock Text="Driver attribution" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" /><ProgressBar x:Name="ModuleCoverageBar" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="Resolved driver attribution coverage" /><TextBlock x:Name="ModuleAttributionCoverageText" Text="—" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}" /></StackPanel>
                                <StackPanel Grid.Column="1" MinWidth="120" Spacing="4"><TextBlock Text="CPUs observed" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" /><TextBlock x:Name="ObservedProcessorCountText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" /></StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Top modules" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                    <TextBlock x:Name="TopModuleText" Text="No observation yet." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}" />
                                    <ListView x:Name="TopModulesList" MinHeight="120" MaxHeight="250" IsItemClickEnabled="False" SelectionMode="None" AutomationProperties.Name="Top observed kernel modules"><ListView.ItemTemplate><DataTemplate><Grid Padding="0,7" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding EventSummary}" FontSize="11" Foreground="{ThemeResource MutedTextBrush}" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding DurationSummary}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="CPU concentration" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                    <TextBlock Text="Ranked by observed DPC + ISR event count" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                    <ListView x:Name="TopProcessorsList" MinHeight="120" MaxHeight="250" IsItemClickEnabled="False" SelectionMode="None" AutomationProperties.Name="Observed CPU concentration"><ListView.ItemTemplate><DataTemplate><Grid Padding="0,7" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" Foreground="{ThemeResource TextBrush}" /><TextBlock Text="{Binding EventSummary}" FontSize="11" Foreground="{ThemeResource MutedTextBrush}" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding TailSummary}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="ObservationQualityText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}" Text="Quality evidence will appear after capture." />

                            <Border Padding="16" CornerRadius="12" Background="{ThemeResource SurfaceAltBrush}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3"><TextBlock Text="Repeated baseline quality" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" /><TextBlock Text="Five clean windows · minimum 20 events per metric/window · explicit noise/drift gate" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}" /></StackPanel>
                                        <TextBlock Grid.Column="1" x:Name="BaselineVerdictText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" Text="Not captured" />
                                    </Grid>
                                    <ProgressBar x:Name="BaselineProgressBar" Minimum="0" Maximum="5" Value="0" AutomationProperties.Name="Baseline capture progress" />
                                    <TextBlock x:Name="BaselineStatusText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextBrush}" Text="Build a repeated baseline to measure normal inter-window variation." />
                                    <TextBlock x:Name="BaselineMetricsText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}" Text="No baseline metrics yet." />
                                    <TextBlock x:Name="BaselineReasonsText" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}" Text="Capture integrity, sample adequacy, noise and drift reasons will appear here." />
                                    <ListView x:Name="BaselineWindowsList" MaxHeight="230" IsItemClickEnabled="False" SelectionMode="None" AutomationProperties.Name="Baseline capture windows">
                                        <ListView.ItemTemplate><DataTemplate><Grid Padding="0,6" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" /><TextBlock Grid.Column="1" Text="{Binding IntegritySummary}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource MutedTextBrush}" /><TextBlock Grid.Column="2" Text="{Binding DpcSummary}" FontSize="11" Foreground="{ThemeResource MutedTextBrush}" /><TextBlock Grid.Column="3" Text="{Binding IsrSummary}" FontSize="11" Foreground="{ThemeResource MutedTextBrush}" /></Grid></DataTemplate></ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
