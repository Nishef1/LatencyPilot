<Window
    x:Class="LatencyPilot.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource CanvasBrush}"
          Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native custom title-bar drag region. System caption buttons occupy the right inset. -->
        <Grid x:Name="AppTitleBarDragRegion"
              Height="{StaticResource TitleBarHeight}"
              Background="Transparent">
            <Grid Margin="18,0,148,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="10">
                    <Border Width="22"
                            Height="22"
                            CornerRadius="7"
                            Background="{ThemeResource AccentSoftBrush}">
                        <Border Width="8"
                                Height="8"
                                CornerRadius="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="LatencyPilot"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextBrush}" />
                    <Border Style="{StaticResource PillBorderStyle}"
                            Padding="8,3">
                        <TextBlock x:Name="VersionText"
                                   Text="v—"
                                   FontSize="10"
                                   Foreground="{ThemeResource MutedTextBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Border Style="{StaticResource PillBorderStyle}"
                            Background="{ThemeResource SuccessSoftBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Border Width="7"
                                    Height="7"
                                    CornerRadius="4"
                                    Background="{ThemeResource SuccessBrush}" />
                            <TextBlock Text="Observation only"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource SuccessBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="{StaticResource ContentMaxWidth}"
                  Padding="{StaticResource PagePadding}"
                  HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Hero / action hierarchy -->
                <Grid Grid.Row="0" ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="7" MaxWidth="760">
                        <TextBlock Text="LATENCY HEALTH"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="110"
                                   Foreground="{ThemeResource AccentBrush}" />
                        <TextBlock Text="Measure what Windows is really doing."
                                   Style="{StaticResource HeroTitleTextStyle}" />
                        <TextBlock Text="Capture trustworthy DPC/ISR evidence, find where interrupt work concentrates, and build a repeatable baseline before making any optimization decision."
                                   Style="{StaticResource MutedBodyTextStyle}"
                                   FontSize="14"
                                   MaxWidth="720" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Spacing="8">
                        <Button x:Name="CaptureObservationButton"
                                IsEnabled="False"
                                Click="CaptureObservationButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Quick snapshot · 5 s"
                                ToolTipService.ToolTip="Capture a five-second diagnostic snapshot (Ctrl+O)"
                                AutomationProperties.AcceleratorKey="Ctrl+O">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="O" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button x:Name="CaptureBaselineButton"
                                IsEnabled="False"
                                Click="CaptureBaselineButton_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Build baseline · ~2 min"
                                ToolTipService.ToolTip="Settle LatencyPilot for five seconds, then build five repeated 20-second windows (Ctrl+B)"
                                AutomationProperties.AcceleratorKey="Ctrl+B">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="B" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button x:Name="ExportEvidenceButton"
                                IsEnabled="False"
                                Click="ExportEvidenceButton_Click"
                                Style="{StaticResource QuietButtonStyle}"
                                Content="Export JSON"
                                ToolTipService.ToolTip="Export the latest completed aggregate evidence as JSON (Ctrl+E)"
                                AutomationProperties.AcceleratorKey="Ctrl+E">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="E" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Compact service / safety state. -->
                <Border Grid.Row="2"
                        Style="{StaticResource SubtleCardStyle}"
                        Padding="16,12">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="34"
                                Height="34"
                                CornerRadius="11"
                                Background="{ThemeResource SurfaceRaisedBrush}">
                            <Border x:Name="ServiceStatusDot"
                                    Width="9"
                                    Height="9"
                                    CornerRadius="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AccentBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                            <TextBlock x:Name="ServiceStatusBadgeText"
                                       Text="Checking service"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextBrush}" />
                            <TextBlock x:Name="ServiceStatusText"
                                       Text="Checking the local observation service…"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                            <TextBlock Text="No system settings are changed"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{ThemeResource SubtleTextBrush}" />
                            <Button x:Name="RefreshServiceButton"
                                    Click="RefreshServiceButton_Click"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Content="Refresh"
                                    ToolTipService.ToolTip="Refresh service status (Ctrl+R)"
                                    AutomationProperties.AcceleratorKey="Ctrl+R">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="R" />
                                </Button.KeyboardAccelerators>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="MainWorkspace"
                      Grid.Row="4"
                      ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MainLeftColumn" Width="328" />
                        <ColumnDefinition x:Name="MainRightColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="WorkspaceLayoutStates">
                            <VisualState x:Name="NarrowWorkspace">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="MainLeftColumn.Width" Value="*" />
                                    <Setter Target="MainRightColumn.Width" Value="0" />
                                    <Setter Target="LeftRail.(Grid.Column)" Value="0" />
                                    <Setter Target="LeftRail.(Grid.Row)" Value="0" />
                                    <Setter Target="ObservationCard.(Grid.Column)" Value="0" />
                                    <Setter Target="ObservationCard.(Grid.Row)" Value="1" />
                                    <Setter Target="ObservationCard.Margin" Value="0,18,0,0" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="WideWorkspace">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="1120" />
                                </VisualState.StateTriggers>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <!-- Machine context: compact, useful, secondary. -->
                    <StackPanel x:Name="LeftRail"
                                Grid.Column="0"
                                Spacing="12">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="This PC"
                                                   Style="{StaticResource SubsectionTitleTextStyle}" />
                                        <TextBlock Text="Measurement context"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Style="{StaticResource PillBorderStyle}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="LOCAL"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource MutedTextBrush}" />
                                    </Border>
                                </Grid>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Operating system"
                                               Style="{StaticResource MetricLabelTextStyle}" />
                                    <TextBlock x:Name="OperatingSystemText"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextBrush}" />
                                </StackPanel>

                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricTileStyle}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Logical CPUs" Style="{StaticResource MetricLabelTextStyle}" />
                                            <TextBlock x:Name="HardwareLogicalProcessorCountText" Text="—" FontSize="23" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricTileStyle}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Physical cores" Style="{StaticResource MetricLabelTextStyle}" />
                                            <TextBlock x:Name="PhysicalCoreCountText" Text="—" FontSize="23" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricTileStyle}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="SMT cores" Style="{StaticResource MetricLabelTextStyle}" />
                                            <TextBlock x:Name="SmtCoreCountText" Text="—" FontSize="23" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricTileStyle}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="PnP devices" Style="{StaticResource MetricLabelTextStyle}" />
                                            <TextBlock x:Name="PresentDeviceCountText" Text="—" FontSize="23" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerBrush}" />

                                <Grid ColumnSpacing="14" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Packages / groups" Style="{StaticResource MetricLabelTextStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock x:Name="PackageCountText" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                            <TextBlock Text="/" Foreground="{ThemeResource SubtleTextBrush}" />
                                            <TextBlock x:Name="ProcessorGroupCountText" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <TextBlock Text="OS / process" Style="{StaticResource MetricLabelTextStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock x:Name="OsArchitectureText" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                            <TextBlock Text="/" Foreground="{ThemeResource SubtleTextBrush}" />
                                            <TextBlock x:Name="ProcessArchitectureText" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">
                                        <TextBlock Text="Processors available to app" Style="{StaticResource MetricLabelTextStyle}" />
                                        <TextBlock x:Name="ProcessAvailableProcessorCountText" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SubtleCardStyle}">
                            <StackPanel Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SuccessBrush}" />
                                    <TextBlock Text="Read-only boundary"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextBrush}" />
                                </StackPanel>
                                <TextBlock Text="LatencyPilot is measuring only. MSI, affinity, power, network, and device-policy mutation remain disabled."
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="4" Padding="4,0">
                            <TextBlock x:Name="TopologyStatusText"
                                       Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock x:Name="DeviceInventoryStatusText"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Main evidence workspace. Child remains a StackPanel for dynamic scenario/snapshot cards. -->
                    <Border x:Name="ObservationCard"
                            Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            Padding="22">
                        <StackPanel Spacing="18">
                            <!-- index 0: dynamic MeasurementScenario card is inserted immediately after this header. -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Kernel latency"
                                               Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock Text="Decision-grade evidence from ETW DPC/ISR capture, attribution, and repeated stability windows."
                                               Style="{StaticResource MutedBodyTextStyle}" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Style="{StaticResource PillBorderStyle}"
                                        Background="{ThemeResource AccentSoftBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="5 × 20 s baseline"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentBrush}" />
                                </Border>
                            </Grid>

                            <!-- index 1 before dynamic insertion: capture state -->
                            <Border Style="{StaticResource SubtleCardStyle}"
                                    Padding="15,12">
                                <StackPanel Spacing="3">
                                    <TextBlock x:Name="KernelCaptureStatusText"
                                               Text="No observation has been captured yet."
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextBrush}" />
                                    <TextBlock Text="Use Quick snapshot for diagnosis; use Build baseline for comparison-quality stability evidence."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Border>

                            <!-- index 2 before dynamic insertion: primary metrics -->
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource MetricTileStyle}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="DPC events" Style="{StaticResource MetricLabelTextStyle}" />
                                        <TextBlock x:Name="DpcCountText" Text="—" Style="{StaticResource MetricValueTextStyle}" />
                                        <TextBlock x:Name="DpcP99Text" Text="—" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource MetricTileStyle}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="DPC p99.9" Style="{StaticResource MetricLabelTextStyle}" />
                                        <TextBlock x:Name="DpcP999Text" Text="—" Style="{StaticResource MetricValueTextStyle}" />
                                        <TextBlock Text="tail latency" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource MetricTileStyle}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="ISR events" Style="{StaticResource MetricLabelTextStyle}" />
                                        <TextBlock x:Name="IsrCountText" Text="—" Style="{StaticResource MetricValueTextStyle}" />
                                        <TextBlock x:Name="IsrP99Text" Text="—" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource MetricTileStyle}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="ISR p99.9" Style="{StaticResource MetricLabelTextStyle}" />
                                        <TextBlock x:Name="IsrP999Text" Text="—" Style="{StaticResource MetricValueTextStyle}" />
                                        <TextBlock Text="tail latency" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- PremiumObservationUi inserts Snapshot evidence at index 3. -->
                            <Border Style="{StaticResource SubtleCardStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="Driver attribution"
                                                   Style="{StaticResource SubsectionTitleTextStyle}" />
                                        <ProgressBar x:Name="ModuleCoverageBar"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="0"
                                                     Height="5"
                                                     AutomationProperties.Name="Resolved driver attribution coverage" />
                                        <TextBlock x:Name="ModuleAttributionCoverageText"
                                                   Text="—"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                MinWidth="110"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <TextBlock Text="CPUs observed" Style="{StaticResource MetricLabelTextStyle}" />
                                        <TextBlock x:Name="ObservedProcessorCountText"
                                                   Text="—"
                                                   FontSize="25"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource SubtleCardStyle}"
                                        Background="{ThemeResource PremiumSurfaceBrush}"
                                        BorderBrush="{ThemeResource DividerBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Top modules" Style="{StaticResource SubsectionTitleTextStyle}" />
                                        <TextBlock x:Name="TopModuleText"
                                                   Text="No observation yet."
                                                   Style="{StaticResource CaptionTextStyle}" />
                                        <ListView x:Name="TopModulesList"
                                                  Style="{StaticResource EvidenceListStyle}"
                                                  MinHeight="64"
                                                  MaxHeight="250"
                                                  IsItemClickEnabled="False"
                                                  SelectionMode="None"
                                                  AutomationProperties.Name="Top observed kernel modules">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="0,7" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Name}" Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding EventSummary}" Style="{StaticResource CaptionTextStyle}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DurationSummary}"
                                                                   VerticalAlignment="Center"
                                                                   Style="{StaticResource CaptionTextStyle}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Style="{StaticResource SubtleCardStyle}"
                                        Background="{ThemeResource PremiumSurfaceBrush}"
                                        BorderBrush="{ThemeResource DividerBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="CPU concentration" Style="{StaticResource SubsectionTitleTextStyle}" />
                                        <TextBlock Text="Ranked by observed DPC + ISR event count" Style="{StaticResource CaptionTextStyle}" />
                                        <ListView x:Name="TopProcessorsList"
                                                  Style="{StaticResource EvidenceListStyle}"
                                                  MinHeight="64"
                                                  MaxHeight="250"
                                                  IsItemClickEnabled="False"
                                                  SelectionMode="None"
                                                  AutomationProperties.Name="Observed CPU concentration">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="0,7" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Name}" Foreground="{ThemeResource TextBrush}" />
                                                            <TextBlock Text="{Binding EventSummary}" Style="{StaticResource CaptionTextStyle}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding TailSummary}"
                                                                   VerticalAlignment="Center"
                                                                   Style="{StaticResource CaptionTextStyle}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Padding="14,10"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Background="{ThemeResource AccentSofterBrush}">
                                <StackPanel Spacing="3">
                                    <TextBlock x:Name="ObservationQualityText"
                                               Text="Quality evidence will appear after capture."
                                               Style="{StaticResource MutedBodyTextStyle}" />
                                    <TextBlock x:Name="EvidenceExportStatusText"
                                               Text="Complete an observation or repeated baseline to enable JSON evidence export."
                                               Style="{StaticResource CaptionTextStyle}"
                                               AutomationProperties.Name="Evidence export status" />
                                </StackPanel>
                            </Border>

                            <Border Padding="18"
                                    CornerRadius="{StaticResource RadiusLarge}"
                                    Background="{ThemeResource AccentSoftBrush}"
                                    BorderBrush="{ThemeResource DividerBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="11">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Repeated decision baseline"
                                                       Style="{StaticResource SubsectionTitleTextStyle}" />
                                            <TextBlock Text="Five 20-second windows quantify normal noise and drift before any candidate can be compared fairly."
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Style="{StaticResource PillBorderStyle}"
                                                Background="{ThemeResource SurfaceRaisedBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="BaselineVerdictText"
                                                       Text="Not captured"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextBrush}" />
                                        </Border>
                                    </Grid>

                                    <ProgressBar x:Name="BaselineProgressBar"
                                                 Minimum="0"
                                                 Maximum="5"
                                                 Value="0"
                                                 Height="5"
                                                 AutomationProperties.Name="Baseline capture progress" />
                                    <TextBlock x:Name="BaselineStatusText"
                                               Text="Build a repeated baseline to measure normal inter-window variation."
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextBrush}" />
                                    <TextBlock x:Name="BaselineMetricsText"
                                               Text="No baseline metrics yet."
                                               Style="{StaticResource MutedBodyTextStyle}" />
                                    <TextBlock x:Name="BaselineReasonsText"
                                               Text="Duration, capture integrity, sample adequacy, noise and drift reasons will appear here."
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <ListView x:Name="BaselineWindowsList"
                                              Style="{StaticResource EvidenceListStyle}"
                                              MaxHeight="230"
                                              IsItemClickEnabled="False"
                                              SelectionMode="None"
                                              AutomationProperties.Name="Baseline capture windows">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0,6" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding IntegritySummary}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource MutedTextBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DpcSummary}" Style="{StaticResource CaptionTextStyle}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding IsrSummary}" Style="{StaticResource CaptionTextStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
