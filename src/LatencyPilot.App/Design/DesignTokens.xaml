<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LatencyPilot visual SSOT.
        The shell stays Windows-native and Mica-backed; content surfaces are quiet,
        layered, and data-first. Chart colors identify datasets, while semantic
        colors communicate evidence state only.
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ShellBackdropBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="WorkspaceBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="CanvasBrush" Color="#00FFFFFF" />
            <StaticResource x:Key="SurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#FFF5F5F7" />
            <StaticResource x:Key="PremiumSurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F7FFFFFF" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FFF2F2F4" />
            <!-- Translucent glass surfaces let the Mica backdrop breathe through. -->
            <SolidColorBrush x:Key="GlassCardBrush" Color="#E8FFFFFF" />
            <SolidColorBrush x:Key="GlassRaisedBrush" Color="#F3FFFFFF" />
            <LinearGradientBrush x:Key="AmbientWashBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#1A2F7CF6" />
                <GradientStop Offset="0.5" Color="#148B5CF6" />
                <GradientStop Offset="1" Color="#002F7CF6" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FF2F7CF6" />
                <GradientStop Offset="1" Color="#FF7C5CFF" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NavigationBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="NavigationSelectedBrush"
                             Color="{ThemeResource SystemAccentColor}"
                             Opacity="0.08" />
            <StaticResource x:Key="NavigationIconBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="TextBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="MutedTextBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="SubtleTextBrush" ResourceKey="TextFillColorTertiaryBrush" />
            <StaticResource x:Key="BorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <SolidColorBrush x:Key="DividerBrush" Color="#10000000" />

            <SolidColorBrush x:Key="ChartTrackBrush" Color="#FFE9E9EC" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="#FFDCDCE1" />
            <SolidColorBrush x:Key="ChartAccentPrimaryBrush" Color="#FF7357D5" />
            <SolidColorBrush x:Key="ChartAccentSecondaryBrush" Color="#FF087CCF" />
            <SolidColorBrush x:Key="ChartAccentTertiaryBrush" Color="#FF69AEE8" />
            <SolidColorBrush x:Key="ChartWarmBrush" Color="#FFC96B0B" />
            <SolidColorBrush x:Key="ChartCellBrush" Color="#FF1683E8" />
            <SolidColorBrush x:Key="ChartPrimarySoftBrush" Color="#FF7357D5" Opacity="0.09" />
            <SolidColorBrush x:Key="ChartWarmSoftBrush" Color="#FFC96B0B" Opacity="0.09" />

            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush"
                             Color="{ThemeResource SystemAccentColor}"
                             Opacity="0.09" />
            <SolidColorBrush x:Key="AccentSofterBrush"
                             Color="{ThemeResource SystemAccentColor}"
                             Opacity="0.05" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />

            <SolidColorBrush x:Key="SuccessBrush" Color="#FF157A19" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#FF157A19" Opacity="0.09" />
            <StaticResource x:Key="WarningBrush" ResourceKey="SystemFillColorCautionBrush" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFD98700" Opacity="0.10" />
            <SolidColorBrush x:Key="ImpactBrush" Color="#FFC45D00" />
            <SolidColorBrush x:Key="ImpactSoftBrush" Color="#FFC45D00" Opacity="0.09" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFC42B1C" Opacity="0.09" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ShellBackdropBrush" Color="#00000000" />
            <SolidColorBrush x:Key="WorkspaceBrush" Color="#00000000" />
            <SolidColorBrush x:Key="CanvasBrush" Color="#00000000" />
            <StaticResource x:Key="SurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#D92A2A2C" />
            <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#FF303033" />
            <StaticResource x:Key="PremiumSurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F72D2D30" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF36363A" />
            <!-- Translucent glass surfaces let the Mica backdrop breathe through. -->
            <SolidColorBrush x:Key="GlassCardBrush" Color="#B82D2D30" />
            <SolidColorBrush x:Key="GlassRaisedBrush" Color="#CC333337" />
            <LinearGradientBrush x:Key="AmbientWashBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#335B9CFF" />
                <GradientStop Offset="0.5" Color="#249D7BFF" />
                <GradientStop Offset="1" Color="#005B9CFF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FF5B9CFF" />
                <GradientStop Offset="1" Color="#FF9D7BFF" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NavigationBrush" Color="#00000000" />
            <SolidColorBrush x:Key="NavigationSelectedBrush"
                             Color="{ThemeResource SystemAccentColor}"
                             Opacity="0.12" />
            <StaticResource x:Key="NavigationIconBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="TextBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="MutedTextBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="SubtleTextBrush" ResourceKey="TextFillColorTertiaryBrush" />
            <StaticResource x:Key="BorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <SolidColorBrush x:Key="DividerBrush" Color="#18FFFFFF" />

            <SolidColorBrush x:Key="ChartTrackBrush" Color="#FF3A3A3E" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="#FF444449" />
            <SolidColorBrush x:Key="ChartAccentPrimaryBrush" Color="#FFAB98FF" />
            <SolidColorBrush x:Key="ChartAccentSecondaryBrush" Color="#FF64D2FF" />
            <SolidColorBrush x:Key="ChartAccentTertiaryBrush" Color="#FF7FC5F5" />
            <SolidColorBrush x:Key="ChartWarmBrush" Color="#FFFFA85C" />
            <SolidColorBrush x:Key="ChartCellBrush" Color="#FF64D2FF" />
            <SolidColorBrush x:Key="ChartPrimarySoftBrush" Color="#FFAB98FF" Opacity="0.13" />
            <SolidColorBrush x:Key="ChartWarmSoftBrush" Color="#FFFFA85C" Opacity="0.11" />

            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush"
                             Color="{ThemeResource SystemAccentColor}"
                             Opacity="0.14" />
            <SolidColorBrush x:Key="AccentSofterBrush"
                             Color="{ThemeResource SystemAccentColor}"
                             Opacity="0.08" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />

            <SolidColorBrush x:Key="SuccessBrush" Color="#FF78D56E" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#FF78D56E" Opacity="0.12" />
            <StaticResource x:Key="WarningBrush" ResourceKey="SystemFillColorCautionBrush" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFFCE100" Opacity="0.10" />
            <SolidColorBrush x:Key="ImpactBrush" Color="#FFFFA85C" />
            <SolidColorBrush x:Key="ImpactSoftBrush" Color="#FFFFA85C" Opacity="0.10" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFFF9EA8" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFFF9EA8" Opacity="0.10" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ShellBackdropBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WorkspaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceStrongBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PremiumSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <!-- High Contrast stays flat and opaque: no translucency or gradients. -->
            <SolidColorBrush x:Key="GlassCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AmbientWashBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AccentGradientBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NavigationSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationIconBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChartTrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChartAccentPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChartAccentSecondaryBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ChartAccentTertiaryBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ChartWarmBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChartCellBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChartPrimarySoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ChartWarmSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AccentSofterBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ImpactBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ImpactSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">20</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space7">32</x:Double>
    <x:Double x:Key="Space8">40</x:Double>

    <x:Double x:Key="FontCaption">12</x:Double>
    <x:Double x:Key="FontBodySmall">13</x:Double>
    <x:Double x:Key="FontBody">14</x:Double>
    <x:Double x:Key="FontSection">16</x:Double>
    <x:Double x:Key="FontHeading">20</x:Double>
    <x:Double x:Key="FontMetric">29</x:Double>
    <x:Double x:Key="FontHero">32</x:Double>

    <x:Double x:Key="ControlHeight">40</x:Double>
    <x:Double x:Key="TitleBarHeight">50</x:Double>
    <x:Double x:Key="InitialWindowWidth">1664</x:Double>
    <x:Double x:Key="InitialWindowHeight">936</x:Double>
    <x:Double x:Key="ContentMaxWidth">1360</x:Double>
    <x:Double x:Key="ChartMinHeight">226</x:Double>
    <x:Double x:Key="DashboardGap">16</x:Double>

    <!-- Layout thresholds are effective content widths, independent of display scaling. -->
    <x:Double x:Key="HeaderInlineThreshold">920</x:Double>
    <x:Double x:Key="MetricsFourColumnThreshold">1080</x:Double>
    <x:Double x:Key="ChartsTwoColumnThreshold">880</x:Double>
    <x:Double x:Key="PreparationTwoColumnThreshold">1040</x:Double>
    <x:Double x:Key="ChartPlotHeight">184</x:Double>
    <x:Double x:Key="ChartCompactPlotHeight">150</x:Double>
    <x:Double x:Key="ChartPlotMinHeight">124</x:Double>
    <x:Double x:Key="MetricCardMinHeight">112</x:Double>
    <x:Double x:Key="MetricIconSize">40</x:Double>
    <Thickness x:Key="WorkspaceMargin">0,10,20,8</Thickness>
    <Thickness x:Key="ChartCardPadding">18,16,18,18</Thickness>

    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">20</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Shared soft elevation for glass cards and primary actions. -->
    <ThemeShadow x:Key="CardShadow" />

    <Thickness x:Key="PagePadding">28,20,32,36</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="CompactCardPadding">12</Thickness>
    <Thickness x:Key="MetricTilePadding">16,14</Thickness>
    <Thickness x:Key="ButtonPadding">16,9</Thickness>
    <Thickness x:Key="PillPadding">8,4</Thickness>
</ResourceDictionary>
