<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LatencyPilot visual SSOT.
        Colors, spacing, radii, typography scale, and shared dimensions live here.
        Screens and component styles consume these keys instead of hard-coding values.
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="CanvasBrush" Color="#FFF6F7FA" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EAF2F4F8" />
            <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#F3E9EDF5" />
            <SolidColorBrush x:Key="PremiumSurfaceBrush" Color="#F7FFFFFF" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FFF1F3F8" />
            <SolidColorBrush x:Key="TextBrush" Color="#FF151821" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#FF667085" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF8790A3" />
            <SolidColorBrush x:Key="BorderBrush" Color="#D8D9DEE8" />
            <SolidColorBrush x:Key="DividerBrush" Color="#A8DDE2EB" />
            <SolidColorBrush x:Key="ChartTrackBrush" Color="#FFE3E7EF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF5B5CE2" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF4D4ED2" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFEEEFFF" />
            <SolidColorBrush x:Key="AccentSofterBrush" Color="#A8F3F3FF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF087A5A" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#FFE7F7F1" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FF9A5A00" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFFFF4DA" />
            <SolidColorBrush x:Key="ImpactBrush" Color="#FFB54708" />
            <SolidColorBrush x:Key="ImpactSoftBrush" Color="#FFFFEDDF" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFB42318" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFFDECEA" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="CanvasBrush" Color="#FF0C0F15" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#E8151922" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E91B202B" />
            <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#F1262C38" />
            <SolidColorBrush x:Key="PremiumSurfaceBrush" Color="#F21A1E28" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FF1D222D" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF242A36" />
            <SolidColorBrush x:Key="TextBrush" Color="#FFF4F6FA" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#FFAEB7C7" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF8792A5" />
            <SolidColorBrush x:Key="BorderBrush" Color="#D6373E4D" />
            <SolidColorBrush x:Key="DividerBrush" Color="#A83A4252" />
            <SolidColorBrush x:Key="ChartTrackBrush" Color="#FF2A303C" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF9293FF" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFA5A6FF" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF272844" />
            <SolidColorBrush x:Key="AccentSofterBrush" Color="#A823243B" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF55D5A7" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#FF123128" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFF0B75A" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#FF352817" />
            <SolidColorBrush x:Key="ImpactBrush" Color="#FFFF955C" />
            <SolidColorBrush x:Key="ImpactSoftBrush" Color="#FF3A2318" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFFF786F" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FF3A1C1C" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="CanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceStrongBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PremiumSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChartTrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AccentSofterBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ImpactBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ImpactSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">20</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space7">32</x:Double>
    <x:Double x:Key="Space8">40</x:Double>

    <x:Double x:Key="FontCaption">11</x:Double>
    <x:Double x:Key="FontBodySmall">12</x:Double>
    <x:Double x:Key="FontBody">14</x:Double>
    <x:Double x:Key="FontSection">16</x:Double>
    <x:Double x:Key="FontHeading">20</x:Double>
    <x:Double x:Key="FontMetric">28</x:Double>
    <x:Double x:Key="FontHero">34</x:Double>

    <x:Double x:Key="ControlHeight">38</x:Double>
    <x:Double x:Key="TitleBarHeight">48</x:Double>
    <x:Double x:Key="ContentMaxWidth">1520</x:Double>
    <x:Double x:Key="RailWidth">328</x:Double>

    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">20</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <Thickness x:Key="PagePadding">30,22,30,40</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="CompactCardPadding">16</Thickness>
    <Thickness x:Key="MetricTilePadding">16,14</Thickness>
    <Thickness x:Key="ButtonPadding">16,8</Thickness>
    <Thickness x:Key="PillPadding">10,5</Thickness>
</ResourceDictionary>
