<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LatencyPilot visual SSOT.
        Windows theme resources own text/card/stroke semantics; chart colors stay
        stable so measurements remain visually comparable across accent choices.
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ShellBackdropBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="WorkspaceBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="CanvasBrush" Color="#00FFFFFF" />
            <StaticResource x:Key="SurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#FFF3F3F3" />
            <StaticResource x:Key="PremiumSurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FAFFFFFF" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="NavigationBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="NavigationSelectedBrush"
                             Color="{ThemeResource SystemAccentColor}"
                             Opacity="0.10" />
            <StaticResource x:Key="NavigationIconBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="TextBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="MutedTextBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="SubtleTextBrush" ResourceKey="TextFillColorTertiaryBrush" />
            <StaticResource x:Key="BorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="DividerBrush" ResourceKey="CardStrokeColorDefaultBrush" />

            <SolidColorBrush x:Key="ChartTrackBrush" Color="#FFE8E8E8" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="#FFE6E6E6" />
            <SolidColorBrush x:Key="ChartAccentPrimaryBrush" Color="#FF7656E8" />
            <SolidColorBrush x:Key="ChartAccentSecondaryBrush" Color="#FF0F6CBD" />
            <SolidColorBrush x:Key="ChartAccentTertiaryBrush" Color="#FF8CC7F5" />
            <SolidColorBrush x:Key="ChartWarmBrush" Color="#FFD97706" />
            <SolidColorBrush x:Key="ChartCellBrush" Color="#FF2B88D8" />
            <SolidColorBrush x:Key="ChartPrimarySoftBrush" Color="#FF7656E8" Opacity="0.12" />
            <SolidColorBrush x:Key="ChartWarmSoftBrush" Color="#FFD97706" Opacity="0.12" />

            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush"
                             Color="{ThemeResource SystemAccentColor}"
                             Opacity="0.12" />
            <SolidColorBrush x:Key="AccentSofterBrush"
                             Color="{ThemeResource SystemAccentColor}"
                             Opacity="0.07" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />

            <SolidColorBrush x:Key="SuccessBrush" Color="#FF0F7B0F" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#FF0F7B0F" Opacity="0.10" />
            <StaticResource x:Key="WarningBrush" ResourceKey="SystemFillColorCautionBrush" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF9A825" Opacity="0.12" />
            <SolidColorBrush x:Key="ImpactBrush" Color="#FFC65D00" />
            <SolidColorBrush x:Key="ImpactSoftBrush" Color="#FFC65D00" Opacity="0.10" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFC42B1C" Opacity="0.10" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ShellBackdropBrush" Color="#00000000" />
            <SolidColorBrush x:Key="WorkspaceBrush" Color="#00000000" />
            <SolidColorBrush x:Key="CanvasBrush" Color="#00000000" />
            <StaticResource x:Key="SurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F2262626" />
            <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#FF2D2D2D" />
            <StaticResource x:Key="PremiumSurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FA242424" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF333333" />
            <SolidColorBrush x:Key="NavigationBrush" Color="#00000000" />
            <SolidColorBrush x:Key="NavigationSelectedBrush"
                             Color="{ThemeResource SystemAccentColor}"
                             Opacity="0.16" />
            <StaticResource x:Key="NavigationIconBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="TextBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="MutedTextBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="SubtleTextBrush" ResourceKey="TextFillColorTertiaryBrush" />
            <StaticResource x:Key="BorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="DividerBrush" ResourceKey="CardStrokeColorDefaultBrush" />

            <SolidColorBrush x:Key="ChartTrackBrush" Color="#FF343434" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="#FF383838" />
            <SolidColorBrush x:Key="ChartAccentPrimaryBrush" Color="#FFA78BFA" />
            <SolidColorBrush x:Key="ChartAccentSecondaryBrush" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="ChartAccentTertiaryBrush" Color="#FF75B6E7" />
            <SolidColorBrush x:Key="ChartWarmBrush" Color="#FFF2C94C" />
            <SolidColorBrush x:Key="ChartCellBrush" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="ChartPrimarySoftBrush" Color="#FFA78BFA" Opacity="0.16" />
            <SolidColorBrush x:Key="ChartWarmSoftBrush" Color="#FFF2C94C" Opacity="0.14" />

            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush"
                             Color="{ThemeResource SystemAccentColor}"
                             Opacity="0.18" />
            <SolidColorBrush x:Key="AccentSofterBrush"
                             Color="{ThemeResource SystemAccentColor}"
                             Opacity="0.10" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />

            <SolidColorBrush x:Key="SuccessBrush" Color="#FF6CCB5F" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#FF6CCB5F" Opacity="0.12" />
            <StaticResource x:Key="WarningBrush" ResourceKey="SystemFillColorCautionBrush" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFFCE100" Opacity="0.12" />
            <SolidColorBrush x:Key="ImpactBrush" Color="#FFFFA54F" />
            <SolidColorBrush x:Key="ImpactSoftBrush" Color="#FFFFA54F" Opacity="0.12" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFFF99A4" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFFF99A4" Opacity="0.12" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ShellBackdropBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WorkspaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceStrongBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PremiumSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NavigationSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationIconBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChartTrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChartAccentPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChartAccentSecondaryBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ChartAccentTertiaryBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ChartWarmBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChartCellBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChartPrimarySoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ChartWarmSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AccentSofterBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ImpactBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ImpactSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">20</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space7">32</x:Double>
    <x:Double x:Key="Space8">40</x:Double>

    <x:Double x:Key="FontCaption">12</x:Double>
    <x:Double x:Key="FontBodySmall">13</x:Double>
    <x:Double x:Key="FontBody">14</x:Double>
    <x:Double x:Key="FontSection">16</x:Double>
    <x:Double x:Key="FontHeading">20</x:Double>
    <x:Double x:Key="FontMetric">28</x:Double>
    <x:Double x:Key="FontHero">28</x:Double>

    <x:Double x:Key="ControlHeight">36</x:Double>
    <x:Double x:Key="TitleBarHeight">52</x:Double>
    <x:Double x:Key="InitialWindowWidth">1664</x:Double>
    <x:Double x:Key="InitialWindowHeight">936</x:Double>
    <x:Double x:Key="ContentMaxWidth">1600</x:Double>
    <GridLength x:Key="NavigationRailWidth">176</GridLength>
    <GridLength x:Key="ContextPanelWidth">244</GridLength>
    <x:Double x:Key="ChartMinHeight">204</x:Double>
    <x:Double x:Key="DashboardGap">16</x:Double>

    <!-- Layout thresholds are effective content widths, independent of display scaling. -->
    <GridLength x:Key="NavigationCompactWidth">64</GridLength>
    <x:Double x:Key="NavigationExpandedThreshold">1460</x:Double>
    <x:Double x:Key="ContextVisibleThreshold">1220</x:Double>
    <x:Double x:Key="HeaderInlineThreshold">980</x:Double>
    <x:Double x:Key="MetricsFourColumnThreshold">900</x:Double>
    <x:Double x:Key="ChartsTwoColumnThreshold">760</x:Double>
    <x:Double x:Key="PreparationTwoColumnThreshold">1040</x:Double>
    <x:Double x:Key="SystemArtworkHeight">132</x:Double>
    <x:Double x:Key="ChartPlotHeight">168</x:Double>
    <x:Double x:Key="ChartCompactPlotHeight">144</x:Double>
    <x:Double x:Key="ChartPlotMinHeight">120</x:Double>
    <x:Double x:Key="MetricCardMinHeight">112</x:Double>
    <x:Double x:Key="MetricIconSize">36</x:Double>
    <Thickness x:Key="WorkspaceMargin">0,8,16,8</Thickness>
    <Thickness x:Key="ChartCardPadding">16,14</Thickness>
    <Thickness x:Key="NavigationItemPadding">12,8</Thickness>

    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">8</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <Thickness x:Key="PagePadding">20,18,24,24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="CompactCardPadding">12</Thickness>
    <Thickness x:Key="MetricTilePadding">14,12</Thickness>
    <Thickness x:Key="ButtonPadding">14,7</Thickness>
    <Thickness x:Key="PillPadding">9,4</Thickness>
</ResourceDictionary>