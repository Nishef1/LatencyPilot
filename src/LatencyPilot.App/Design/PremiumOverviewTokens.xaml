<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Overview-specific palette and interaction recipes.
        Category colors identify measured datasets; semantic colors identify state.
        Large surfaces stay neutral so the data, not decoration, owns attention.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BrandActionBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="BrandActionHoverBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.90" />
            <SolidColorBrush x:Key="BrandActionPressedBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.82" />
            <SolidColorBrush x:Key="BrandActionSoftBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.09" />

            <SolidColorBrush x:Key="DpcCategoryBrush" Color="#FFD97706" />
            <SolidColorBrush x:Key="DpcCategorySoftBrush" Color="#FFD97706" Opacity="0.09" />
            <SolidColorBrush x:Key="IsrCategoryBrush" Color="#FF7357D5" />
            <SolidColorBrush x:Key="IsrCategorySoftBrush" Color="#FF7357D5" Opacity="0.09" />
            <SolidColorBrush x:Key="CpuCategoryBrush" Color="#FF087CCF" />
            <SolidColorBrush x:Key="CpuCategorySoftBrush" Color="#FF087CCF" Opacity="0.09" />

            <SolidColorBrush x:Key="SemanticGoodBrush" Color="#FF157A19" />
            <SolidColorBrush x:Key="SemanticGoodSoftBrush" Color="#FF157A19" Opacity="0.09" />
            <SolidColorBrush x:Key="SemanticAttentionBrush" Color="#FF9A5A00" />
            <SolidColorBrush x:Key="SemanticAttentionSoftBrush" Color="#FFD98700" Opacity="0.10" />
            <SolidColorBrush x:Key="SemanticFailureBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="SemanticFailureSoftBrush" Color="#FFC42B1C" Opacity="0.09" />

            <StaticResource x:Key="PremiumOverviewCardBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <SolidColorBrush x:Key="PremiumOverviewRaisedBrush" Color="#ECFFFFFF" />
            <SolidColorBrush x:Key="PremiumOverviewDividerBrush" Color="#10000000" />
            <SolidColorBrush x:Key="PremiumOverviewQuietBrush" Color="#09000000" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BrandActionBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="BrandActionHoverBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.92" />
            <SolidColorBrush x:Key="BrandActionPressedBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.84" />
            <SolidColorBrush x:Key="BrandActionSoftBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.14" />

            <SolidColorBrush x:Key="DpcCategoryBrush" Color="#FFFFA85C" />
            <SolidColorBrush x:Key="DpcCategorySoftBrush" Color="#FFFFA85C" Opacity="0.11" />
            <SolidColorBrush x:Key="IsrCategoryBrush" Color="#FFAB98FF" />
            <SolidColorBrush x:Key="IsrCategorySoftBrush" Color="#FFAB98FF" Opacity="0.13" />
            <SolidColorBrush x:Key="CpuCategoryBrush" Color="#FF64D2FF" />
            <SolidColorBrush x:Key="CpuCategorySoftBrush" Color="#FF64D2FF" Opacity="0.12" />

            <SolidColorBrush x:Key="SemanticGoodBrush" Color="#FF78D56E" />
            <SolidColorBrush x:Key="SemanticGoodSoftBrush" Color="#FF78D56E" Opacity="0.12" />
            <SolidColorBrush x:Key="SemanticAttentionBrush" Color="#FFF1C75B" />
            <SolidColorBrush x:Key="SemanticAttentionSoftBrush" Color="#FFF1C75B" Opacity="0.11" />
            <SolidColorBrush x:Key="SemanticFailureBrush" Color="#FFFF9EA8" />
            <SolidColorBrush x:Key="SemanticFailureSoftBrush" Color="#FFFF9EA8" Opacity="0.10" />

            <StaticResource x:Key="PremiumOverviewCardBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <SolidColorBrush x:Key="PremiumOverviewRaisedBrush" Color="#E62D2D30" />
            <SolidColorBrush x:Key="PremiumOverviewDividerBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="PremiumOverviewQuietBrush" Color="#0AFFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BrandActionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandActionHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandActionPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandActionSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DpcCategoryBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="DpcCategorySoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="IsrCategoryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="IsrCategorySoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CpuCategoryBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="CpuCategorySoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SemanticGoodBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SemanticGoodSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SemanticAttentionBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SemanticAttentionSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SemanticFailureBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SemanticFailureSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PremiumOverviewCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PremiumOverviewRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PremiumOverviewDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PremiumOverviewQuietBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="PremiumPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource BrandActionBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OnAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="17,9" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PremiumLinkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource BrandActionBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>